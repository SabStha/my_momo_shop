APP_NAME="Amako Momo Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Set this to your machine's local IP so the mobile app can reach the backend
# Find your IP: ipconfig (Windows) or ifconfig (Mac/Linux)
APP_URL=http://192.168.0.10:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database4
DB_USERNAME=root
# Leave blank if using XAMPP default (no password)
DB_PASSWORD=

# Use file drivers locally — no Redis needed for dev
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Sanctum — must include your local IP:port so mobile auth works
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,192.168.0.10:8000

MEMCACHED_HOST=127.0.0.1

# Redis — not needed for local dev (SESSION_DRIVER and CACHE_DRIVER are set to file above)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@amakomomo.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher — required for real-time POS order updates and notification bell
# Create a free account at https://pusher.com, create a "Channels" app, paste credentials here
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap2

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# eSewa — get sandbox credentials from team lead for local testing
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
# Use "sandbox" for local dev, "production" for live
ESEWA_ENVIRONMENT=sandbox

# Twilio — SMS notifications. Optional for local dev (notifications will silently fail)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# OpenAI — powers AI popup and weekly digest. Optional: app degrades gracefully without it
OPENAI_API_KEY=

# Mailchimp — newsletter integration. Optional for local dev
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
